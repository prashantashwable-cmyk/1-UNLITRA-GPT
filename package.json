{
  "name": "aiec-elevator-os",
  "private": true,
  "version": "1.0.0",
  "description": "AIEC Elevator OS — role-based mobile work manager for the complete elevator business workflow.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
